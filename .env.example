# Local development URL; Compose constructs its internal PostgreSQL URL below.
DATABASE_URL=postgresql+psycopg://jobagent:local_demo_only@db:5432/jobagent
POSTGRES_DB=jobagent
POSTGRES_PASSWORD=local_demo_only
DEMO_MODE=true
DISPLAY_TIMEZONE=Europe/Berlin
# Leave unset for localhost only. Required for external access; send as Bearer token.
ADMIN_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
OPENAI_API_KEY=
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=Fieldwork Executive Job Agent
LLM_MODEL=openai/gpt-4o
# Configure current USD / million token prices before enabling LLM matching.
LLM_INPUT_PRICE=0
LLM_OUTPUT_PRICE=0
