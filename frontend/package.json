{
  "name": "european-job-agent-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src vite.config.ts",
    "format:check": "prettier --check src vite.config.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "1.55.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "@types/node": "24.12.0",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
